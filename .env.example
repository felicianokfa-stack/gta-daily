# Copie para .env.local e preencha. Nunca faça commit de segredos.
# Sem DATABASE_URL e sem as chaves do Supabase, o app roda em MODO LOCAL (PGlite + usuário de teste).

# --- Supabase (projeto gta-daily-plataforma, sa-east-1) ---
# Valores públicos: podem ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://lcocstithbpjtsupgsiv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_59u9_TAbfWuc6bW1Ugnm-w_SNlNVzat
# SEGREDO: string de conexão do Postgres (Supabase → Project Settings → Database → Connection string,
# modo "Transaction pooler", porta 6543). Usada só no servidor e no worker.
DATABASE_URL=

# --- Claude (Anthropic) ---
# SEGREDO: necessária para os agentes Pesquisador e Verificador. Sem ela as etapas ficam em "Exige ação".
ANTHROPIC_API_KEY=

# --- Worker serverless (Vercel Cron → GET /api/worker/tick) ---
# SEGREDO: sem ele a rota fica desativada (401).
CRON_SECRET=
# Etapas processadas por chamada da rota (padrão 3).
WORKER_TICK_MAX=3
# Intervalo do worker contínuo quando a fila está vazia, em ms (padrão 5000).
WORKER_IDLE_MS=5000

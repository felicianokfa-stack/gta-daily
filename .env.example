# Copie para .env.local e preencha. Nunca faça commit de segredos.
# Sem DATABASE_URL e sem as chaves do Supabase, o app roda em MODO LOCAL (PGlite + usuário de teste).

# --- Supabase (projeto gta-daily-plataforma, sa-east-1) ---
# Valores públicos: podem ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://lcocstithbpjtsupgsiv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_59u9_TAbfWuc6bW1Ugnm-w_SNlNVzat
# SEGREDO: string de conexão do Postgres (Supabase → Project Settings → Database → Connection string,
# modo "Transaction pooler", porta 6543). Usada só no servidor e no worker.
DATABASE_URL=

# --- Provedor de IA dos agentes ---
# Escolha EXPLÍCITA do provedor padrão: mock | gemini | ollama | anthropic.
# Sem AI_PROVIDER (e sem provedor escolhido no projeto, em Configurações) as etapas ficam em "Exige ação":
# o modo de demonstração nunca é ligado por omissão e nenhum provedor é usado como fallback de outro.
AI_PROVIDER=
# mock = demonstração: respostas fictícias e marcadas como simuladas, sem rede e sem custo.
# Cenário de teste do mock (só desenvolvimento): ok | invalid_schema | rate_limited | contradiction
# MOCK_SCENARIO=ok

# --- Google Gemini (IA real em plano gratuito) ---
# SEGREDO: chave do Google AI Studio de um projeto SEM faturamento (o app não consegue verificar isso).
# No plano gratuito o Google pode usar o conteúdo enviado para melhorar seus produtos: só conteúdo público/de teste.
GEMINI_API_KEY=
# Modelo (confirme na documentação oficial quais têm plano gratuito). Padrão: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
# Limite local de requisições por minuto (padrão 5; confira o limite atual do seu plano no AI Studio).
# GEMINI_MAX_RPM=5
# Busca do Google (grounding): desligada por padrão; confirme antes se existe sem custo no seu plano.
# GEMINI_GROUNDING=on
# Limites de tamanho: entrada em caracteres (padrão 60000) e saída em tokens (padrão 8192).
# AI_MAX_INPUT_CHARS=60000
# GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Ollama (modelo local, opcional; use no worker local, não na Vercel) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=

# --- Claude (Anthropic) — preservado para ativação futura; API paga ---
# SEGREDO: só é usada se AI_PROVIDER=anthropic (ou escolhida no projeto). Nunca entra como fallback.
ANTHROPIC_API_KEY=
# Opcional: modelo usado pelos agentes (padrão claude-sonnet-5-5, escolhido pelo custo).
# CLAUDE_MODEL=claude-opus-5-5

# --- YouTube Data API (opcional) ---
# SEGREDO: só metadados de vídeos públicos. Não baixa vídeos nem transcreve. O app funciona sem ela.
# YOUTUBE_API_KEY=

# --- Worker serverless (Vercel Cron → GET /api/worker/tick) ---
# SEGREDO: sem ele a rota fica desativada (401).
CRON_SECRET=
# Etapas processadas por chamada da rota (padrão 3).
WORKER_TICK_MAX=3
# Intervalo do worker contínuo quando a fila está vazia, em ms (padrão 5000).
WORKER_IDLE_MS=5000
